# Copy to .env (gitignored). quackd loads it automatically via python-dotenv.
# You only need the key for the provider you pass to `--provider`.
# `--provider fake` needs no key at all.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional: override the model for the chosen provider (see docs/faq.md for defaults).
# QUACKD_MODEL=claude-opus-5
