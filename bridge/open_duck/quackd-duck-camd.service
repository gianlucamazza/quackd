[Unit]
Description=quackd camera server for the Open Duck Mini v2 (one JPEG over HTTP)
Documentation=https://github.com/rokbenko/quackd/blob/main/docs/adapters/open_duck.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
SupplementaryGroups=video
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/.virtualenvs/open-duck-mini-runtime/bin/python \
    /opt/quackd/quackd_duck_camd.py --bind 0.0.0.0 --port 9872 --fps 1

# This process is the one the kernel should take if memory runs short on a 512 MB board.
# The walk loop sets OOMScoreAdjust=-500 for the opposite reason: losing the camera costs
# you the verbs that need it, losing the walk loop mid-stride costs you the duck.
MemoryMax=140M
OOMScoreAdjust=500
Nice=5

# Unlike the bridge, restarting this is harmless. It reads a camera and answers GET.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
