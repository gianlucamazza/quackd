{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rokbenko/quackd/blob/main/quackd/duckfile/schema.json",
  "$defs": {
    "Budgets": {
      "additionalProperties": false,
      "description": "Hard stops. The loop ends when any of these is hit, whatever the LLM thinks.",
      "properties": {
        "max_steps": {
          "default": 40,
          "description": "Maximum number of LLM decisions.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_minutes": {
          "default": 5.0,
          "description": "Wall-clock (or sim-clock) cap.",
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Max Minutes",
          "type": "number"
        },
        "max_llm_calls": {
          "default": 40,
          "description": "Maximum provider calls.",
          "maximum": 2000,
          "minimum": 1,
          "title": "Max Llm Calls",
          "type": "integer"
        }
      },
      "title": "Budgets",
      "type": "object"
    },
    "FlockAllocation": {
      "additionalProperties": false,
      "description": "How a flock decides who kicks. Deterministic; the LLM never runs the auction.",
      "properties": {
        "method": {
          "const": "auction",
          "default": "auction",
          "title": "Method",
          "type": "string"
        },
        "bid": {
          "const": "ball_distance",
          "default": "ball_distance",
          "title": "Bid",
          "type": "string"
        },
        "tie_break": {
          "const": "duck_id",
          "default": "duck_id",
          "title": "Tie Break",
          "type": "string"
        },
        "hysteresis_pct": {
          "default": 20.0,
          "description": "A challenger must bid this much lower to unseat the current claimant.",
          "maximum": 100,
          "minimum": 0,
          "title": "Hysteresis Pct",
          "type": "number"
        },
        "claim_lease_s": {
          "default": 6.0,
          "description": "Longest a claim may be held before re-auction (sim clock). A fixed fuse from the moment the claim is granted, not a progress timer.",
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Claim Lease S",
          "type": "number"
        }
      },
      "title": "FlockAllocation",
      "type": "object"
    },
    "FlockSafety": {
      "additionalProperties": false,
      "properties": {
        "min_separation_m": {
          "default": 0.4,
          "maximum": 2.0,
          "minimum": 0.1,
          "title": "Min Separation M",
          "type": "number"
        },
        "one_claimant": {
          "default": true,
          "description": "At most one duck approaches the ball at a time. Always enforced in v0.3; false is rejected rather than silently ignored.",
          "title": "One Claimant",
          "type": "boolean"
        },
        "per_duck_heartbeat_s": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Per Duck Heartbeat S",
          "type": "number"
        }
      },
      "title": "FlockSafety",
      "type": "object"
    },
    "FlockSearch": {
      "additionalProperties": false,
      "properties": {
        "partition": {
          "const": "heading",
          "default": "heading",
          "title": "Partition",
          "type": "string"
        },
        "restart_s": {
          "default": 8.0,
          "description": "Re-scan the sector when nothing was found for this long.",
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Restart S",
          "type": "number"
        }
      },
      "title": "FlockSearch",
      "type": "object"
    },
    "FlockSection": {
      "additionalProperties": false,
      "description": "Cooperating ducks (v0.3, simulator only). The coordinator enforces this block.",
      "properties": {
        "members": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": 3,
          "description": "Count (2-4, named duck-0..) or a list of 2-4 unique slugs.",
          "title": "Members"
        },
        "allocation": {
          "$ref": "#/$defs/FlockAllocation"
        },
        "safety": {
          "$ref": "#/$defs/FlockSafety"
        },
        "search": {
          "$ref": "#/$defs/FlockSearch"
        }
      },
      "title": "FlockSection",
      "type": "object"
    },
    "LearnedVerbRef": {
      "additionalProperties": false,
      "description": "Reserved for v2. The shape a `.duck` will use to pull in a learned (ONNX) verb.\n\nSee `docs/learned-verbs.md`. Parsed and validated today; nothing executes it.",
      "properties": {
        "name": {
          "description": "Verb name it registers as.",
          "title": "Name",
          "type": "string"
        },
        "policy": {
          "description": "Path or URL of the ONNX policy.",
          "title": "Policy",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "LLM-facing description.",
          "title": "Description",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "name",
        "policy"
      ],
      "title": "LearnedVerbRef",
      "type": "object"
    },
    "VerbsSection": {
      "additionalProperties": false,
      "description": "Which verbs the LLM may call, and which need a human to say yes first.",
      "properties": {
        "allow": {
          "description": "Verbs the LLM may call. Anything else is refused.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allow",
          "type": "array"
        },
        "confirm": {
          "description": "Verbs (subset of `allow`) that prompt a human y/N before executing.",
          "items": {
            "type": "string"
          },
          "title": "Confirm",
          "type": "array"
        }
      },
      "required": [
        "allow"
      ],
      "title": "VerbsSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The contract. This is what `schema.json` describes and what the executor enforces.",
  "properties": {
    "duck": {
      "const": 0,
      "description": "Spec version. Only 0 exists.",
      "title": "Duck",
      "type": "integer"
    },
    "name": {
      "description": "Slug: lowercase letters, digits, hyphens.",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "description": "One line, human-facing.",
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "verbs": {
      "$ref": "#/$defs/VerbsSection"
    },
    "budgets": {
      "$ref": "#/$defs/Budgets",
      "default": {
        "max_steps": 40,
        "max_minutes": 5.0,
        "max_llm_calls": 40
      }
    },
    "success": {
      "description": "Success criteria the LLM must judge itself against.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Success",
      "type": "array"
    },
    "abort_when": {
      "description": "Abort conditions. 'Battery below N%' and 'Same verb fails N times in a row' are enforced by the executor; other entries are passed to the LLM as instructions.",
      "items": {
        "type": "string"
      },
      "title": "Abort When",
      "type": "array"
    },
    "persona": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Tone for the LLM. Optional.",
      "title": "Persona"
    },
    "providers": {
      "description": "Providers this duck was tested with (not enforced).",
      "items": {
        "type": "string"
      },
      "title": "Providers",
      "type": "array"
    },
    "learned_verbs": {
      "description": "Reserved for v2 learned verbs. Must be empty in v0.1.",
      "items": {
        "$ref": "#/$defs/LearnedVerbRef"
      },
      "title": "Learned Verbs",
      "type": "array"
    },
    "flock": {
      "anyOf": [
        {
          "$ref": "#/$defs/FlockSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Cooperating ducks (v0.3, simulator only). Absent means a single duck."
    }
  },
  "required": [
    "duck",
    "name",
    "description",
    "verbs",
    "success"
  ],
  "title": "quackd .duck v0 frontmatter",
  "type": "object"
}
